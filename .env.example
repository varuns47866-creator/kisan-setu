# Kisan Setu Environment Configuration

# -------------------------------------------------------------
# 1. Local Development (.env)
# -------------------------------------------------------------
# PORT=5000
# NODE_ENV=development
# VITE_API_URL=http://localhost:5000

# -------------------------------------------------------------
# 2. Render Deployment (Web Service or Blueprint)
# -------------------------------------------------------------
# NODE_ENV=production
# PORT=10000
# (Render automatically injects PORT and handles routing)
# If deploying full-stack on Render (Frontend + Backend),
# VITE_API_URL can be left unset/empty.

# -------------------------------------------------------------
# 3. Google Gemini AI Key (AI Copilot & Crop Vision Scanner)
# -------------------------------------------------------------
# Get a free key at https://aistudio.google.com/
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-1.5-flash

# -------------------------------------------------------------
# 4. Optional Separate Frontend (Vercel)
# -------------------------------------------------------------
# VITE_API_URL=https://<your-render-service>.onrender.com
